# Normaliza finais de linha: o repositório guarda LF e o Git não reescreve arquivos binários.
* text=auto eol=lf

*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.rules text eol=lf
*.svg  text eol=lf

*.png  binary
*.jpg  binary
*.webp binary
*.woff2 binary
